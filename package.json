{
  "name": "voice-messenger",
  "version": "1.0.16",
  "description": "Voice Messenger with P2P WebRTC Calls and Chat",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server start",
    "dev": "node start-dev.js",
    "electron:dev": "electron electron/main.cjs",
    "electron:pack": "npm --prefix server install --no-audit --no-fund && npm run build && npm --prefix server prune --omit=dev && electron-builder --win --dir",
    "electron:dist": "npm --prefix server install --no-audit --no-fund && npm run build && npm --prefix server prune --omit=dev && electron-builder --win nsis portable --publish never",
    "publish-update": "node publish-release.cjs"
  },
  "build": {
    "appId": "com.voicemessenger.app",
    "productName": "VoiceMessenger",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "build/installer.nsh",
      "artifactName": "VoiceMessenger-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VoiceMessenger-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "server/dist/**/*",
      "server/package.json",
      "server/node_modules/**/*",
      "client/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "start-server.bat",
        "to": "start-server.bat"
      },
      {
        "from": "README.md",
        "to": "README-LAN.md"
      }
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
